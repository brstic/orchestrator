# A Linux server for an office: what docs/INSTALL.md section 0 asks for (Node 22, tmux, git, curl, openssl).
# Claude Code itself is not installed here — a container has no Claude account — so `claude` on this
# machine is the scripted test worker (tests/fixtures/fake-claude.mjs, mounted by the test).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tmux git curl ca-certificates procps openssl && rm -rf /var/lib/apt/lists/*
RUN printf '#!/bin/sh\nexec node /fixtures/fake-claude.mjs "$@"\n' > /usr/local/bin/claude && chmod +x /usr/local/bin/claude
RUN useradd -m -s /bin/bash office
USER office
WORKDIR /home/office
