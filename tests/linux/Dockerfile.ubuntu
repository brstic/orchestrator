# An Ubuntu LTS machine for the host agent — the userland a default WSL2 install gives you.
# Node 22 is copied from the official image; tmux, git and curl are Ubuntu's own packages.
FROM node:22-bookworm-slim AS node
FROM ubuntu:24.04
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends tmux git curl ca-certificates procps && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash dev
USER dev
WORKDIR /home/dev
