# "Your server": a Linux machine you can only reach over SSH. Node 22, tmux, git, curl, sshd,
# and the scripted worker fixture installed the way an npm-installed Claude Code looks
# (a `claude` command that runs node on …/claude-code/cli.js).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tmux git curl ca-certificates procps iproute2 openssh-server && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd /opt/claude-code && echo '{"type":"module"}' > /opt/claude-code/package.json \
 && printf '#!/bin/sh\nexec node /opt/claude-code/cli.js "$@"\n' > /usr/local/bin/claude && chmod +x /usr/local/bin/claude \
 && useradd -m -s /bin/bash dev && passwd -d dev >/dev/null && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
