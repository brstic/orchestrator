{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "ORCHESTRATOR \u2014 a 3D virtual office where real Claude Code sessions work as employees. Your code. Your company. Your world.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "server": "node apps/server/src/main.ts",
    "agent": "node apps/host-agent/src/cli.ts",
    "dev:ui": "pnpm --filter @orchestrator/desktop dev",
    "build:ui": "pnpm --filter @orchestrator/desktop build",
    "build": "node scripts/build.mjs && pnpm build:ui",
    "start": "node scripts/start-local.mjs",
    "desktop": "node scripts/repair-electron.mjs && pnpm --filter @orchestrator/desktop electron",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.ts\"",
    "test:all": "pnpm test && pnpm test:e2e",
    "demo": "node tests/real/acceptance.ts",
    "test:real": "node tests/real/acceptance.ts",
    "dev:office": "node scripts/dev-office.ts",
    "electron:repair": "node scripts/repair-electron.mjs",
    "apply-config": "node scripts/apply-config.mjs",
    "test:real:approvals": "node tests/real/approvals.ts",
    "test:real:talk": "node tests/real/talk.ts",
    "package": "node scripts/package.mjs",
    "test:real:sdk": "node tests/real/sdk.ts",
    "test:linux": "sh tests/linux/run.sh",
    "package:smoke": "node scripts/smoke-package.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "test:machines": "sh tests/linux/run-multi.sh",
    "test:ssh": "sh tests/linux/run-ssh.sh",
    "test:real:team": "node tests/real/team.ts",
    "package:linux": "node scripts/package.mjs --linux --no-app",
    "test:linux:desktop": "sh tests/linux/desktop-smoke.sh",
    "test:real:flows": "node tests/real/flows.ts",
    "test:real:team:sdk": "TEAM_RUNTIME=managed_sdk node tests/real/team.ts",
    "test:linux:deb": "sh tests/linux/deb-smoke.sh",
    "test:real:flows2": "node tests/real/flows2.ts",
    "package:windows": "node scripts/package.mjs --windows --no-app",
    "package:all": "node scripts/package.mjs --linux --windows",
    "package:notarize": "node scripts/notarize.mjs",
    "test:real:auto": "node tests/real/auto.ts",
    "serve": "node scripts/start-local.mjs --door",
    "office": "node scripts/office-admin.mjs",
    "test:central": "node tests/linux/central-office.mjs",
    "deploy:server": "sh scripts/deploy-server.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "@orchestrator/contracts": "workspace:*",
    "@orchestrator/database": "workspace:*",
    "@orchestrator/execution": "workspace:*",
    "@orchestrator/orchestration": "workspace:*",
    "@orchestrator/integrations": "workspace:*",
    "@orchestrator/terminal": "workspace:*",
    "@orchestrator/game-systems": "workspace:*"
  }
}
